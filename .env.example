# 复制为 .env 并按需填写。.env 不会进入版本控制。
#
# 注意：dotenv 只在 development / test 环境加载本文件。
# 生产环境请通过真实的环境变量提供这些值。

# --- 数据库 ---
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=localhost

# --- Redis（config/cable.yml 与 Sidekiq 均读取）---
REDIS_URL=redis://localhost:6379/1

# --- 文件存储（可选，Cloudflare R2 / S3 兼容）---
# 留空或设为 local 时使用本地磁盘（见 config/storage.yml 的 local 服务）：
# git clone 后无需任何第三方账号即可启动、上传、预览、下载，适合本地开发和试用。
#
# ⚠️ 部署到 Render 一类 PaaS 时，必须设置 STORAGE_SERVICE=r2 并填好下面四项
# R2_*。这类平台的文件系统是临时的（每次部署/重启都会重置为镜像原始状态），
# 继续用本地磁盘会导致已上传的文件在下一次部署后静默丢失——不报错、不告警，
# 数据库里的记录还在，文件本身却已经不存在了。
#
# aws-sdk-s3 已在 Gemfile 中，无需额外安装。设 STORAGE_SERVICE=r2 即可切换，
# 不需要改任何代码。
STORAGE_SERVICE=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
#
# ⚠️ R2 bucket 必须配置 CORS，否则浏览器直传（ActiveStorage Direct Upload，
# 上传时 JS 直接 PUT 到 R2，不经过 Rails 服务器）会被浏览器的跨域策略拦截，
# 控制台报 CORS / preflight 失败，选好文件后一直卡在"上传中"。
# 在 Cloudflare dashboard → R2 → 该 bucket → Settings → CORS policy 里添加：
#
# [
#   {
#     "AllowedOrigins": ["https://your-app-domain.example.com"],
#     "AllowedMethods": ["PUT"],
#     "AllowedHeaders": ["Content-Type", "Content-MD5", "Content-Disposition"],
#     "ExposeHeaders": [],
#     "MaxAgeSeconds": 3600
#   }
# ]
#
# AllowedOrigins 换成部署后的真实访问域名（例如 https://museflow.onrender.com）；
# 本地想直连真实 R2 联调时，再额外加一条 http://localhost:3000。

# --- 自助注册（默认关闭）---
# 留空或任何非 'true' 的值都视为关闭；只有精确等于 'true' 才会打开。
#
# ⚠️ 这是一个单租户自部署系统：所有登录用户看到的都是同一家公司的图纸，
# 没有组织/租户级的数据隔离。打开这个开关意味着任何能访问到 /users/sign_up
# 的人，注册后就能登录进来查看这份数据（新账号默认没有角色、没有权限，
# 但仍然能登录、仍然算“进来了”）。只在你确实需要一个开放注册的演示/评估
# 环境时才打开；生产部署给真实团队用时应保持关闭，改由管理员在后台建账号。
ALLOW_REGISTRATION=

# --- Sidekiq Web 控制台（生产环境必填）---
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=

# --- 异常通知（可选）---
EXCEPTION_SENDER_ADDRESS=
EXCEPTION_RECIPIENTS=

# --- SMTP 邮件发送（可选）---
# 留空时不配置邮件发送，应用仍可启动，但不会真正发出邮件。
SMTP_ADDRESS=
SMTP_PORT=
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- 生产环境 ---
SECRET_KEY_BASE=
