<div id="form">
  <div class="modal-header">
    <h5 class="modal-title"><%= t('notices.reply') %></h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <%= simple_form_for(@user_notice, url: do_reply_notice_path, html: {class: 'form-horizontal group_form'}, wrapper: :horizontal_form) do |f| %>
    <div class="modal-body">
      <%= f.input :reply %>
    </div>
  <% end %>

  <div class="modal-footer">
    <%= button_tag t('common.save'), class: 'btn btn-primary commit', data: { disable_with: t('common.saving') } %>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
  </div>
</div>

<script type="text/javascript">
  $(function(){
    $('.commit').click(function(){
      showSpinner();
      $.ajax({
        type: "patch",
        url: $('.group_form').attr('action'),
        data: $('.group_form').serialize(),
        dataType: 'script',
        async: false,
        error: function(request) {
          alert("Connection error");
        }
      });
    });
  });
</script>
