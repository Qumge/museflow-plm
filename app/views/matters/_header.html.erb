<% content_for :content_header do %>
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><%= t('activerecord.models.matter') %></h4>
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
          <%= link_to matters_path do %>
            <i class="fa fa-dashboard"></i> <%= t('activerecord.models.matter') %>
          <% end %>
        </li>
        <li class="breadcrumb-item active"><%= get_title params %></li>
      </ol>
    </nav>
  </div>
<% end %>
