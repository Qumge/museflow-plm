<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="form-floating mb-3">
    <%= f.text_field :login, autofocus: true, autocomplete: "username", class: 'form-control', placeholder: t('devise_views.login'), id: "login" %>
    <label for="login"><%= t('devise_views.login') %></label>
  </div>

  <div class="form-floating mb-3">
    <%= f.email_field :email, autocomplete: "email", class: 'form-control', placeholder: t('devise_views.email'), id: "email" %>
    <label for="email"><%= t('devise_views.email') %></label>
  </div>

  <div class="form-floating mb-3">
    <%= f.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: t('devise_views.password'), id: "password" %>
    <label for="password"><%= t('devise_views.password') %></label>
  </div>

  <div class="form-floating mb-3">
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: t('devise_views.password_confirmation'), id: "password_confirmation" %>
    <label for="password_confirmation"><%= t('devise_views.password_confirmation') %></label>
  </div>

  <%= f.submit t('devise_views.sign_up'), class: "btn btn-primary btn-login mt-2" %>
<% end %>

<div class="devise-links">
  <%= render "devise/shared/links" %>
</div>
