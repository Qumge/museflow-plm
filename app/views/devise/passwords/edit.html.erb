<h5 class="mb-3 fw-bold"><%= t('devise_views.change_password') %></h5>

<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  <%= f.error_notification %>
  <%= f.input :reset_password_token, as: :hidden %>
  <%= f.full_error :reset_password_token %>

  <%# Neither field has a label: override anymore — this is the password-RESET
      form specifically, where "New password" reads better than the generic
      "Password" the user model's own attribute name would give. simple_form
      resolves simple_form.labels.user.edit.password(_confirmation) first
      (config/locales/simple_form.en.yml, config/locales/zh-CN/simple_form.yml,
      P4 Task 4e) before falling back to the generic attribute name. %>
  <div class="mb-3">
    <%= f.input :password,
                required: true,
                autofocus: true,
                hint: (t('devise_views.minimum_chars', count: @minimum_password_length) if @minimum_password_length),
                input_html: { autocomplete: "new-password", class: "form-control" } %>
  </div>

  <div class="mb-3">
    <%= f.input :password_confirmation, required: true, input_html: { class: "form-control" } %>
  </div>

  <div class="d-grid">
    <%= f.button :submit, t('devise_views.change_password'), class: "btn btn-primary btn-login" %>
  </div>
<% end %>

<div class="devise-links">
  <%= render "devise/shared/links" %>
</div>
