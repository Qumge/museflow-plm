<div id="form">
  <div class="modal-header">
    <h5 class="modal-title"><%= t('common.apply_for_approval') %></h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <%= simple_form_for(@log, url: do_apply_url, html: {class: 'form-horizontal group_form', onkeydown: "if(event.keyCode==13)return false;"}, wrapper: :horizontal_form) do |f| %>
    <div class="modal-body">
      <%= f.input :develop_id, collection: current_user.audit_users(:develop, resource_type).all.collect{|user| [user.name, user.id]}, input_html: { class: 'select2', width: '100%', style: 'width: 100%'} %>
      <%= f.input :flow_id, collection: current_user.audit_users(:flow, resource_type).all.collect{|user| [user.name, user.id]} , input_html: { class: 'select2', width: '100%', style: 'width: 100%'}%>
      <%= f.input :active_id, collection: current_user.audit_users(:active, resource_type).all.collect{|user| [user.name, user.id]} , input_html: { class: 'select2', width: '100%', style: 'width: 100%'}%>
    </div>
  <% end %>

  <div class="modal-footer">
    <%= button_tag t('common.save'), class: 'btn btn-primary commit', data: { disable_with: t('common.saving') } %>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common.cancel') %></button>
  </div>
</div>
<script type="text/javascript">
  $(function(){
    $('.commit').click(function(){
      showSpinner();
      $.ajax({
        type: "Patch",
        url: $('.group_form').attr('action'),
        data: $('.group_form').serialize(),
        dataType: 'script',
        async: false,
        error: function(request) { alert("Connection error"); }
      });
    });
    initSelect2($('.select2'));
  });
</script>
