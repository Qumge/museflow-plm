<%# data-unauthorized carries the server-side translation down to application.js's
    show_flash('failed', ...) call for the remote-modal 403 case (see the fail
    handler on the [data-bs-toggle="modal"] click binding) — that call happens
    in a plain .js asset file with no ERB processing, so it cannot call t()
    itself and instead reads this attribute at click time. %>
<div class="page_tips" style="display: none;" data-unauthorized="<%= t('flash.unauthorized') %>" data-load-failed="<%= t('flash.load_failed') %>">
  <% if notice %>
    <div class="success">
      <div class="inner"><%= notice %><i class="fa fa-close close-tips"></i></div>
    </div>
  <% end %>

  <% if alert %>
    <div class="failed">
      <div class="inner"><%= alert %><i class="fa fa-close close-tips"></i></div>
    </div>
  <% end %>
</div>

<script type="text/javascript">
  $(function(){
    $(".close-tips").on("click", function(){
      $(this).closest(".page_tips").hide();
    });
    var page_tips = $(".page_tips");
    var inner = page_tips.find(".inner");
    if( inner.html() ){
      page_tips.fadeIn(function(){
        setTimeout(function(){ page_tips.fadeOut(); }, 3000);
      });
    }
  })
</script>
