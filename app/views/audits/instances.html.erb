<%= render 'audits/header' %>
<div class="card">
  <div class="card-header p-0 pt-1">
    <ul class="nav nav-tabs" role="tablist">
      <% if can? :do_develop_audit, :instances %>
        <li class="nav-item">
          <a class="nav-link" data-bs-toggle="tab" href="#tab_1" role="tab"><%= t('activerecord.attributes.instance_log.develop_id') %></a>
        </li>
      <% end %>
      <% if can? :do_flow_audit, :instances %>
        <li class="nav-item">
          <a class="nav-link" data-bs-toggle="tab" href="#tab_2" role="tab"><%= t('activerecord.attributes.instance_log.flow_id') %></a>
        </li>
      <% end %>
      <% if can? :do_active_audit, :instances %>
        <li class="nav-item">
          <a class="nav-link" data-bs-toggle="tab" href="#tab_3" role="tab"><%= t('activerecord.attributes.instance_log.active_id') %></a>
        </li>
      <% end %>
    </ul>
  </div>
  <div class="card-body">
    <div class="tab-content">
      <% if can? :do_develop_audit, :instances %>
        <div class="tab-pane fade" id="tab_1" role="tabpanel">
          <%= render 'audits/instances/apply_instances' %>
        </div>
      <% end %>
      <% if can? :do_flow_audit, :instances %>
        <div class="tab-pane fade" id="tab_2" role="tabpanel">
          <%= render 'audits/instances/develop_instances' %>
        </div>
      <% end %>
      <% if can? :do_active_audit, :instances %>
        <div class="tab-pane fade" id="tab_3" role="tabpanel">
          <%= render 'audits/instances/flow_instances' %>
        </div>
      <% end %>
    </div>
  </div>
  <div class="card-footer text-end">
    <%= link_to t('common.back'), audits_path, class: 'btn btn-secondary' %>
  </div>
</div>

<script type="text/javascript">
  $(function(){
    // Bootstrap 5: jQuery's .tab('show') plugin was removed; use the native
    // bootstrap.Tab API to activate the first tab (and its pane) by default.
    var firstTabEl = document.querySelector('.nav-tabs .nav-link');
    if (firstTabEl) {
      new bootstrap.Tab(firstTabEl).show();
    }
  })
  function failed(id){
    if(confirm('<%= t('common.confirm_reject') %>')){
      showSpinner();
      $.ajax({
        type: 'post',
        url: '<%= do_failed_audit_instances_path %>',
        data: {id: id},
        dataType: 'script'
      })
    }
  }
</script>
